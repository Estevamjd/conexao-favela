{
  "expo": {
    "name": "Conexao Favela",
    "slug": "conexao-favela",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "conexaofavela",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "br.com.conexaofavela.app",
      "supportsTablet": true
    },
    "android": {
      "package": "br.com.conexaofavela.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0E7C7B"
        }
      ],
      "expo-localization",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o Conexao Favela use a camera para reconhecer pontos turisticos proximos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
